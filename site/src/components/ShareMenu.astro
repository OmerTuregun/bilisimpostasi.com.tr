---
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  url: string;
  title: string;
  locale?: Locale;
  /** icon: kart altı; bar: haber detay altı */
  variant?: 'icon' | 'bar';
}

const { url, title, locale = 'tr', variant = 'icon' } = Astro.props;
const strings = t(locale);
const whatsappHref = `https://wa.me/?text=${encodeURIComponent(`${title}\n${url}`)}`;
---
<div class:list={['share-menu', `share-menu--${variant}`]} data-share-root>
  {variant === 'bar' && <p class="share-label">{strings.share}</p>}
  <div class="share-controls">
    <button
      type="button"
      class="share-trigger"
      aria-expanded="false"
      aria-haspopup="true"
      aria-label={strings.share}
      data-share-trigger
    >
      <svg class="share-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="18" cy="5" r="3" />
        <circle cx="6" cy="12" r="3" />
        <circle cx="18" cy="19" r="3" />
        <path d="M8.59 13.51l6.83 3.98M15.41 6.51l-6.82 3.98" />
      </svg>
      {variant === 'bar' && <span>{strings.share}</span>}
    </button>

    <div class="share-panel" role="menu" hidden data-share-panel>
      <button
        type="button"
        class="share-action"
        role="menuitem"
        data-share-copy
        data-url={url}
        data-copied={strings.linkCopied}
      >
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" />
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
        </svg>
        <span data-share-copy-label>{strings.copyLink}</span>
      </button>
      <a
        class="share-action"
        role="menuitem"
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" />
        </svg>
        <span>{strings.shareWhatsApp}</span>
      </a>
    </div>
  </div>
</div>

<script>
  declare global {
    interface Window {
      __shareMenuInit?: boolean;
    }
  }

  function closePanel(root: HTMLElement) {
    const trigger = root.querySelector<HTMLButtonElement>('[data-share-trigger]');
    const panel = root.querySelector<HTMLElement>('[data-share-panel]');
    if (!trigger || !panel) return;
    panel.hidden = true;
    trigger.setAttribute('aria-expanded', 'false');
  }

  function openPanel(root: HTMLElement) {
    const trigger = root.querySelector<HTMLButtonElement>('[data-share-trigger]');
    const panel = root.querySelector<HTMLElement>('[data-share-panel]');
    if (!trigger || !panel) return;
    document.querySelectorAll<HTMLElement>('[data-share-root]').forEach((other) => {
      if (other !== root) closePanel(other);
    });
    panel.hidden = false;
    trigger.setAttribute('aria-expanded', 'true');
  }

  function initShareRoot(root: HTMLElement) {
    if (root.dataset.shareReady === '1') return;
    root.dataset.shareReady = '1';

    const trigger = root.querySelector<HTMLButtonElement>('[data-share-trigger]');
    const panel = root.querySelector<HTMLElement>('[data-share-panel]');
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-share-copy]');
    if (!trigger || !panel || !copyBtn) return;

    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (panel.hidden) openPanel(root);
      else closePanel(root);
    });

    copyBtn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const url = copyBtn.dataset.url ?? '';
      const label = copyBtn.querySelector<HTMLElement>('[data-share-copy-label]');
      const original = label?.textContent ?? '';
      const copied = copyBtn.dataset.copied ?? 'Copied';
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = url;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      if (label) {
        label.textContent = copied;
        copyBtn.classList.add('is-copied');
        window.setTimeout(() => {
          label.textContent = original;
          copyBtn.classList.remove('is-copied');
        }, 1800);
      }
    });

    panel.addEventListener('click', (e) => e.stopPropagation());
  }

  function initAll() {
    document.querySelectorAll<HTMLElement>('[data-share-root]').forEach(initShareRoot);
  }

  initAll();
  document.addEventListener('astro:page-load', initAll);

  if (!window.__shareMenuInit) {
    window.__shareMenuInit = true;
    document.addEventListener('click', () => {
      document.querySelectorAll<HTMLElement>('[data-share-root]').forEach(closePanel);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll<HTMLElement>('[data-share-root]').forEach(closePanel);
      }
    });
  }
</script>

<style>
  .share-menu {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
  }
  .share-menu--bar {
    width: 100%;
    align-items: stretch;
    margin-top: 1.5rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--rule);
  }
  .share-label {
    margin: 0 0 0.65rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .share-controls {
    position: relative;
    display: inline-flex;
  }
  .share-menu--bar .share-controls {
    width: 100%;
  }
  .share-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin: 0;
    padding: 0.35rem;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }
  .share-trigger:hover,
  .share-trigger[aria-expanded='true'] {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border-color: color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .share-menu--bar .share-trigger {
    padding: 0.55rem 0.85rem;
    border-color: var(--rule);
    background: var(--surface);
    color: var(--ink);
  }
  .share-icon {
    display: block;
    flex-shrink: 0;
  }
  .share-panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.4rem);
    z-index: 5;
    min-width: 11.5rem;
    padding: 0.35rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: 0 10px 28px var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .share-menu--bar .share-panel {
    left: 0;
    right: auto;
    bottom: auto;
    top: calc(100% + 0.4rem);
    min-width: 13rem;
  }
  .share-panel[hidden] {
    display: none;
  }
  .share-action {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
    margin: 0;
    padding: 0.55rem 0.65rem;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 500;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .share-action:hover {
    background: var(--hover-surface);
    color: var(--accent);
  }
  .share-action.is-copied {
    color: var(--success-text);
    background: var(--success-bg);
  }
  .share-action svg {
    flex-shrink: 0;
  }
</style>
