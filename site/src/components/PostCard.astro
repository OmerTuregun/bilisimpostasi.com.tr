---
import type { CollectionEntry } from 'astro:content';
import { formatDateTime, categoryBadgeColor, DEFAULT_CATEGORY } from '../lib/categories';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const kategori = post.data.kategori ?? DEFAULT_CATEGORY;
const badgeColor = categoryBadgeColor(kategori);
---
<article class="post-card">
  <a class="card-link" href={`/posts/${post.id}/`}>
    <span class="badge" style={`--badge-color: ${badgeColor}`}>{kategori}</span>
    <h2>{post.data.title}</h2>
    <p class="desc">{post.data.description}</p>
    <div class="card-footer">
      <time datetime={post.data.pubDate.toISOString()}>{formatDateTime(post.data.pubDate)}</time>
      <span class="more">Devamını oku →</span>
    </div>
  </a>
</article>

<style>
  .post-card {
    background: #fff;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }
  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1rem;
    text-decoration: none;
    color: inherit;
  }
  .badge {
    align-self: flex-start;
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--badge-color) 14%, white);
    color: var(--badge-color);
    margin-bottom: 0.5rem;
  }
  h2 {
    font-size: 1.02rem;
    line-height: 1.35;
    margin: 0 0 0.45rem;
    font-weight: 700;
  }
  .desc {
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0 0 0.75rem;
    line-height: 1.45;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--rule);
    margin-top: auto;
  }
  time { font-size: 0.72rem; color: var(--muted); }
  .more {
    font-size: 0.78rem;
    color: var(--accent);
    font-weight: 600;
    white-space: nowrap;
  }
  .card-link:hover .more { text-decoration: underline; }
  @media (max-width: 640px) {
    .card-link { padding: 0.7rem; }
    .badge {
      font-size: 0.55rem;
      padding: 0.12rem 0.38rem;
      margin-bottom: 0.35rem;
    }
    h2 {
      font-size: 0.82rem;
      line-height: 1.3;
      margin: 0 0 0.28rem;
    }
    .desc {
      font-size: 0.7rem;
      line-height: 1.35;
      margin: 0 0 0.45rem;
    }
    .card-footer { padding-top: 0.4rem; }
    time { font-size: 0.62rem; }
    .more { display: none; }
  }
</style>
