---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import { postPath, postSlug } from '../lib/posts';
import {
  formatDateTime,
  categoryBadgeColor,
  getCategoryDisplayName,
  DEFAULT_CATEGORY,
  DEFAULT_CATEGORY_EN,
} from '../lib/categories';
import { publicCoverUrl } from '../lib/covers';
import ShareMenu from './ShareMenu.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  rank?: number;
  locale?: Locale;
  /** Above-the-fold cards: skip lazy-load so covers paint on first visit */
  priority?: boolean;
}

const { post, rank, locale = 'tr', priority = false } = Astro.props;
const strings = t(locale);
const slug = postSlug(post.id);
const rawKategori = post.data.kategori ?? (locale === 'en' ? DEFAULT_CATEGORY_EN : DEFAULT_CATEGORY);
const badgeColor = categoryBadgeColor(rawKategori, locale);
const kategori = getCategoryDisplayName(rawKategori, locale);
const coverImage = publicCoverUrl(post.data.coverImage);
const siteBase = Astro.site ?? new URL(Astro.url.origin);
const postUrl = new URL(postPath(locale, slug), siteBase).href;
---
<article class="post-card">
  {typeof rank === 'number' && (
    <span class="rank-badge" aria-hidden="true">{rank}.</span>
  )}
  <a class="card-link" href={postPath(locale, slug)}>
    {coverImage ? (
      <img
        class="card-cover"
        src={coverImage}
        alt=""
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priority ? 'high' : 'auto'}
        width="640"
        height="140"
      />
    ) : (
      <span class="card-cover card-cover-empty" aria-hidden="true"></span>
    )}
    <span class="badge" style={`--badge-color: ${badgeColor}`}>{kategori}</span>
    <h2>{post.data.title}</h2>
    <p class="desc">{post.data.description}</p>
  </a>
  <div class="card-footer">
    <time datetime={post.data.pubDate.toISOString()}>{formatDateTime(post.data.pubDate, locale)}</time>
    <div class="footer-actions">
      <ShareMenu url={postUrl} title={post.data.title} locale={locale} variant="icon" />
      <a class="more" href={postPath(locale, slug)}>{strings.readMore}</a>
    </div>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 12px var(--shadow-sm);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .rank-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 1;
    min-width: 1.85rem;
    height: 1.85rem;
    padding: 0 0.4rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1;
  }
  .post-card:has(.rank-badge) .badge { margin-right: 2.2rem; }
  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px var(--shadow-lg);
  }
  .card-cover {
    width: calc(100% + 2.3rem);
    max-width: none;
    height: 140px;
    min-height: 140px;
    object-fit: cover;
    display: block;
    margin: -1.15rem -1.15rem 0.85rem;
    background:
      linear-gradient(110deg, var(--cover-placeholder) 25%, var(--cover-shimmer-mid) 40%, var(--cover-placeholder) 55%);
    background-size: 200% 100%;
    animation: cover-shimmer 1.2s ease-in-out infinite;
  }
  .card-cover[src] {
    animation: none;
    background: var(--cover-placeholder);
  }
  .card-cover.card-cover-empty {
    animation: none;
    background: var(--cover-placeholder);
  }
  @keyframes cover-shimmer {
    0% { background-position: 100% 0; }
    100% { background-position: -100% 0; }
  }
  .card-link {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    padding: 1.15rem 1.15rem 0.65rem;
    text-decoration: none;
    color: inherit;
  }
  .badge {
    align-self: flex-start;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--badge-color) 14%, var(--badge-blend));
    color: var(--badge-color);
    margin-bottom: 0.7rem;
  }
  h2 {
    font-size: clamp(1.05rem, 4.6vw, 1.22rem);
    line-height: 1.35;
    margin: 0 0 0.55rem;
    font-weight: 700;
    overflow-wrap: break-word;
  }
  .desc {
    font-size: clamp(0.88rem, 3.5vw, 0.98rem);
    color: var(--muted);
    margin: 0 0 0.9rem;
    line-height: 1.5;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    padding: 0.8rem 1.15rem 1rem;
    border-top: 1px solid var(--rule);
    margin-top: auto;
  }
  .footer-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
  }
  time { font-size: 0.8rem; color: var(--muted); }
  .more {
    font-size: 0.88rem;
    color: var(--accent);
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
  }
  .more:hover { text-decoration: underline; }
  @media (hover: none) and (pointer: coarse) {
    .card-cover {
      width: calc(100% + 1.6rem);
      margin: -1.25rem -0.8rem 0.85rem;
    }
    .card-link { padding: 1.25rem 0.8rem 0.55rem; }
    .card-footer { padding: 0.95rem 0.8rem 1.2rem; }
    h2 {
      font-size: clamp(1.12rem, 5.4vw, 1.3rem);
      line-height: 1.4;
      margin: 0 0 0.7rem;
    }
    .desc {
      font-size: clamp(0.92rem, 4vw, 1.05rem);
      line-height: 1.55;
      margin: 0 0 1.05rem;
      -webkit-line-clamp: 4;
    }
    .badge {
      font-size: 0.75rem;
      padding: 0.3rem 0.7rem;
      margin-bottom: 0.85rem;
    }
    .card-footer { padding-top: 0.95rem; }
    time { font-size: 0.85rem; }
  }

  @media (max-width: 768px) {
    .card-cover {
      width: calc(100% + 1.8rem);
      margin: -1.25rem -0.9rem 0.85rem;
    }
    .card-link { padding: 1.25rem 0.9rem 0.55rem; }
    .card-footer { padding: 0.95rem 0.9rem 1.25rem; }
    .badge {
      font-size: 0.82rem;
      padding: 0.32rem 0.85rem;
      margin-bottom: 0.9rem;
    }
    h2 {
      font-size: 1.15rem;
      line-height: 1.4;
      margin: 0 0 0.7rem;
    }
    .desc {
      font-size: 0.98rem;
      line-height: 1.65;
      margin: 0 0 1rem;
      -webkit-line-clamp: 4;
    }
    .card-footer { padding-top: 0.95rem; }
    time { font-size: 0.95rem; }
    .more { display: inline-block; font-size: 0.95rem; white-space: nowrap; }
    .rank-badge {
      font-size: 0.95rem;
      min-width: 2rem;
      height: 2rem;
    }
  }
</style>
