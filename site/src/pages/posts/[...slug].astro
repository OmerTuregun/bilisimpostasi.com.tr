---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { formatDateTime, slugifyCategory, categoryBadgeColor, DEFAULT_CATEGORY } from '../../lib/categories';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const kategori = post.data.kategori ?? DEFAULT_CATEGORY;
const kategoriSlug = slugifyCategory(kategori);
const badgeColor = categoryBadgeColor(kategori);

const siteBase = Astro.site ?? new URL(Astro.url.origin);
const postUrl = new URL(`/posts/${post.id}/`, siteBase).href;
const ogImage = post.data.coverImage
  ? (post.data.coverImage.startsWith('http://') || post.data.coverImage.startsWith('https://')
      ? post.data.coverImage
      : new URL(post.data.coverImage, siteBase).href)
  : new URL('/og-default.png', siteBase).href;
const datePublished = post.data.pubDate.toISOString();
const dateModified = (post.data.updatedDate ?? post.data.pubDate).toISOString();

const relatedPosts = (await getCollection('posts'))
  .filter((p) => p.id !== post.id && (p.data.kategori ?? DEFAULT_CATEGORY) === kategori)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: post.data.title,
  description: post.data.description,
  datePublished,
  dateModified,
  image: [ogImage],
  author: [{ '@type': 'Organization', name: 'blog.omerfarukturegun.com.tr' }],
  publisher: {
    '@type': 'Organization',
    name: 'blog.omerfarukturegun.com.tr',
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
};
---
<Layout
  title={`${post.data.title} — Blog`}
  description={post.data.description}
  ogType="article"
  image={ogImage}
  jsonLd={jsonLd}
>
  <main>
    <div class="post-layout">
      <article class="post-detail" data-pagefind-body>
        <a class="back" href="/">← Ana sayfa</a>
        <a class="badge" href={`/kategori/${kategoriSlug}/`} style={`--badge-color: ${badgeColor}`}>
          {kategori}
        </a>
        <h1>{post.data.title}</h1>
        <p class="meta">
          <time datetime={datePublished}>{formatDateTime(post.data.pubDate)}</time>
          {' · '}
          <a href={post.data.kaynak} rel="noopener noreferrer" target="_blank">Kaynak</a>
        </p>
        <div class="content"><Content /></div>
      </article>

      {relatedPosts.length > 0 && (
        <aside class="related" aria-label="İlgili yazılar">
          <h2>İlgili Yazılar</h2>
          <div class="card-grid">
            {relatedPosts.map((related) => <PostCard post={related} />)}
          </div>
        </aside>
      )}
    </div>
  </main>
</Layout>

<style>
  .post-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  .post-detail { max-width: 42rem; min-width: 0; }
  .back { display: block; margin-bottom: 1.25rem; color: var(--muted); text-decoration: none; }
  .badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--badge-color) 15%, white);
    color: var(--badge-color);
    text-decoration: none;
  }
  h1 { font-size: clamp(1.6rem, 4vw, 2.2rem); line-height: 1.25; margin: 0.85rem 0; }
  .meta {
    color: var(--muted);
    margin: 0 0 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }
  .content :global(p) { margin: 0 0 1rem; }
  .related {
    min-width: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }
  .related h2 {
    font-size: 1.35rem;
    margin: 0 0 1.25rem;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 10px;
  }
  @media (max-width: 1099px) {
    .post-layout {
      grid-template-columns: minmax(0, 1fr) 124px;
      gap: 0.75rem;
    }
    .related {
      padding-top: 0;
      border-top: 0;
      position: sticky;
      top: 5rem;
    }
    .related h2 {
      font-size: 1.05rem;
      line-height: 1.3;
      margin: 0 0 0.7rem;
      overflow-wrap: break-word;
    }
    .card-grid {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }
    .related :global(.card-link) { padding: 0.65rem 0.5rem 0.7rem; }
    .related :global(h2) {
      font-size: 0.92rem;
      line-height: 1.35;
      overflow-wrap: break-word;
    }
    .related :global(.desc) { font-size: 0.8rem; -webkit-line-clamp: 3; }
    .related :global(.badge) { font-size: 0.62rem; padding: 0.18rem 0.4rem; margin-bottom: 0.4rem; }
    .related :global(time) { font-size: 0.7rem; }
    .related :global(.more) { font-size: 0.72rem; white-space: normal; }
  }
  @media (max-width: 768px) {
    .content :global(p) {
      margin: 0 0 1.15rem;
      font-size: 1.12rem;
      line-height: 1.75;
    }
    h1 {
      font-size: 1.7rem;
      line-height: 1.28;
      margin: 0.75rem 0 0.85rem;
    }
    .badge { font-size: 0.82rem; padding: 0.32rem 0.7rem; }
    .meta { font-size: 0.95rem; }
  }
  @media (min-width: 1100px) {
    .post-layout {
      grid-template-columns: 1fr 320px;
      gap: 2rem;
    }
    .related {
      position: sticky;
      top: 5.25rem;
      padding-top: 0;
      border-top: 0;
    }
    .card-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
