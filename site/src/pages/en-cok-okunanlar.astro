---
import { t } from '../i18n/ui';
import { getPosts, postSlug } from '../lib/posts';
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getPopularPosts } from '../lib/popular-posts';

const LOCALE = 'tr' as const;
const strings = t(LOCALE);
const popular = await getPopularPosts(20, LOCALE);
const posts = await getPosts(LOCALE);
const bySlug = new Map(posts.map((post) => [postSlug(post.id), post]));
const ranked = popular
  .map((item, index) => {
    const post = bySlug.get(item.id);
    return post ? { post, rank: index + 1 } : null;
  })
  .filter((item): item is { post: (typeof posts)[number]; rank: number } => item !== null);
---
<Layout
  locale={LOCALE}
  title={`${strings.popularTitle} — Blog`}
  description={strings.popularSub}
>
  <main>
    <h1>{strings.popularTitle}</h1>
    <p class="lede">{strings.popularSub}</p>
    {ranked.length === 0 ? (
      <p class="empty">—</p>
    ) : (
      <div class="card-grid">
        {ranked.map(({ post, rank }) => <PostCard post={post} rank={rank} locale={LOCALE} />)}
      </div>
    )}
  </main>
</Layout>

<style>
  h1 { margin: 0 0 0.35rem; font-size: 1.7rem; }
  .lede { color: var(--muted); margin: 0 0 1.75rem; }
  .empty { color: var(--muted); }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 10px;
  }
  @media (min-width: 1100px) {
    .card-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  }
</style>
