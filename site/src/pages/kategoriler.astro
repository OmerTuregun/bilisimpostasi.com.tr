---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { slugifyCategory, categoryBadgeColor, DEFAULT_CATEGORY } from '../lib/categories';

const posts = await getCollection('posts');
const categories = [...new Set(posts.map((post) => post.data.kategori ?? DEFAULT_CATEGORY))].sort();
---
<Layout title="Kategoriler — Blog" description="Teknoloji ve AI haberleri kategorileri.">
  <main>
    <h1>Kategoriler</h1>
    <p class="lede">Konuya göre haberleri keşfedin.</p>
    <ul>
      {categories.map((name) => (
        <li>
          <a href={`/kategori/${slugifyCategory(name)}/`} style={`--color: ${categoryBadgeColor(name)}`}>
            <span>{name}</span>
            <small>{posts.filter((post) => (post.data.kategori ?? DEFAULT_CATEGORY) === name).length} yazı</small>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>

<style>
  h1 { margin-bottom: 0.25rem; }
  .lede { color: var(--muted); margin: 0 0 2rem; }
  ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.75rem;
  }
  li a {
    display: flex;
    justify-content: space-between;
    padding: 1rem;
    background: #fff;
    border-left: 4px solid var(--color);
    border-radius: 8px;
    color: inherit;
    text-decoration: none;
  }
  small { color: var(--muted); }
</style>
