---
import { t } from '../i18n/ui';
import { homePath, categoriesIndexPath } from '../lib/posts';
import Layout from '../layouts/Layout.astro';

/** Static 404.html — nginx serves this with HTTP 404 for missing paths. */
const LOCALE = 'tr' as const;
const strings = t(LOCALE);
---
<Layout
  locale={LOCALE}
  title={`${strings.notFoundTitle} — Blog`}
  description={strings.notFoundBody}
>
  <main class="not-found">
    <p class="code" aria-hidden="true">404</p>
    <h1>{strings.notFoundHeading}</h1>
    <p class="lead">{strings.notFoundBody}</p>
    <p class="actions">
      <a class="primary" href={homePath(LOCALE)}>{strings.notFoundHome}</a>
      <a href={categoriesIndexPath(LOCALE)}>{strings.notFoundCategories}</a>
    </p>
  </main>
</Layout>

<style>
  .not-found {
    max-width: 36rem;
    margin: 2.5rem auto 4rem;
    text-align: center;
    padding: 0 1rem;
  }
  .code {
    margin: 0 0 0.5rem;
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 12vw, 5rem);
    font-weight: 700;
    line-height: 1;
    color: color-mix(in srgb, var(--accent) 55%, var(--muted));
    letter-spacing: -0.04em;
  }
  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.35rem, 4vw, 1.75rem);
    line-height: 1.3;
  }
  .lead {
    margin: 0 0 1.75rem;
    color: var(--muted);
    line-height: 1.6;
    font-size: 1.02rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    justify-content: center;
    margin: 0;
  }
  .actions a {
    font-weight: 600;
    text-decoration: none;
  }
  .actions a:hover { text-decoration: underline; }
  .actions .primary {
    display: inline-block;
    padding: 0.55rem 1.1rem;
    border-radius: 0.5rem;
    background: var(--accent);
    color: var(--on-accent);
  }
  .actions .primary:hover { text-decoration: none; filter: brightness(1.05); }
</style>
