---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { slugifyCategory, DEFAULT_CATEGORY } from '../../lib/categories';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const categories = [...new Set(posts.map((post) => post.data.kategori ?? DEFAULT_CATEGORY))];
  return categories.map((kategori) => ({
    params: { kategori: slugifyCategory(kategori) },
    props: {
      kategori,
      posts: posts
        .filter((post) => (post.data.kategori ?? DEFAULT_CATEGORY) === kategori)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { kategori, posts } = Astro.props;

const categoryDescriptions: Record<string, string> = {
  'Yapay Zeka':
    'Yapay zekâ modelleri, dil modelleri, sektör şirketleri ve araştırma haberlerinin kısa Türkçe özetleri. Claude, GPT ve açık ağırlık modelleri gibi gelişmeleri bu kategoride takip edin.',
  Teknoloji:
    'Yazılım, donanım, siber güvenlik, bulut ve dijital ürün haberlerinin kısa Türkçe özetleri. Teknoloji gündemindeki seçilmiş gelişmeleri buradan izleyin.',
};
const description =
  categoryDescriptions[kategori] ??
  `${kategori} kategorisindeki teknoloji ve yapay zekâ haberlerinin kısa Türkçe özetleri. Güncel yazıları buradan keşfedebilirsiniz.`;
---
<Layout title={`${kategori} — Blog`} description={description}>
  <main>
    <h1>{kategori}</h1>
    <p class="count">{posts.length} yazı</p>
    <div class="card-grid">{posts.map((post) => <PostCard post={post} />)}</div>
    <p class="back"><a href="/kategoriler">← Tüm kategoriler</a></p>
  </main>
</Layout>

<style>
  h1 { margin: 0; }
  .count { color: var(--muted); margin: 0.25rem 0 1.5rem; }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 10px;
  }
  @media (max-width: 768px) {
    .card-grid {
      grid-template-columns: 1fr;
      gap: 18px 10px;
    }
  }
  @media (min-width: 1100px) and (hover: hover) and (pointer: fine) {
    .card-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
  }
  .back { margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--rule); }
</style>
