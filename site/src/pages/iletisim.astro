---
import { t } from '../i18n/ui';
import Layout from '../layouts/Layout.astro';
import IletisimForm from '../components/IletisimForm.astro';

const LOCALE = 'tr' as const;
const X_URL = 'https://x.com/bilisimpostasi';
---
<Layout locale={LOCALE} title={`${t(LOCALE).contact} — Blog`} description="Bizimle iletişime geçin.">
  <main class="paper-page">
    <div class="paper-page-inner">
      <div class="static-page paper-sheet">
        <h1>İletişim</h1>
        <p>Sorularınız ve önerileriniz için bize ulaşabilirsiniz.</p>
        <p class="contact-line">
          Destek:
          <a class="mail-link" href="mailto:destek@bilisimpostasi.com.tr">destek@bilisimpostasi.com.tr</a>
        </p>
        <p class="social-row">
          <a class="social-x" href={X_URL} target="_blank" rel="noopener noreferrer" aria-label="X'te Bilişim Postası">
            <svg class="x-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.717-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/>
            </svg>
            <span>@bilisimpostasi</span>
          </a>
        </p>

        <h2>Mesaj bırakın</h2>
        <IletisimForm locale={LOCALE} />
      </div>
    </div>
  </main>
</Layout>

<style>
  h2 { margin-top: 2rem; font-size: 1.25rem; }
  .contact-line { margin: 0.85rem 0; }
  .mail-link {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-color: color-mix(in srgb, var(--ink) 35%, transparent);
  }
  .mail-link:hover {
    text-decoration-color: var(--ink);
  }
  .social-row { margin: 1.15rem 0 0; }
  .social-x {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.95rem;
    padding: 0.35rem 0.55rem;
    margin-left: -0.55rem;
    border-radius: 4px;
  }
  .social-x:hover {
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }
  .x-icon { display: block; flex-shrink: 0; }
</style>
