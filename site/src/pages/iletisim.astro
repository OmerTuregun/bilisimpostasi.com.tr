---
import { t } from '../i18n/ui';
import Layout from '../layouts/Layout.astro';

const LOCALE = 'tr' as const;
---
<Layout locale={LOCALE} title={`${t(LOCALE).contact} — Blog`} description="Bizimle iletişime geçin.">
  <main class="static-page">
    <h1>İletişim</h1>
    <p>Sorularınız ve önerileriniz için bize ulaşabilirsiniz.</p>
    <p><a href="mailto:iletisim@omerfarukturegun.com.tr">iletisim@omerfarukturegun.com.tr</a></p>
  </main>
</Layout>

<style>.static-page { max-width: 42rem; }</style>
