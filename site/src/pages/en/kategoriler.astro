---
import type { CategoryKey } from '../../i18n/config';
import { CATEGORY_ORDER, categoryLabel, categoryKeyFromName, CATEGORY_SLUG } from '../../i18n/config';
import { t } from '../../i18n/ui';
import { getPosts, categoryPath } from '../../lib/posts';
import { categoryBadgeColor, DEFAULT_CATEGORY_EN } from '../../lib/categories';
import Layout from '../../layouts/Layout.astro';

const LOCALE = 'en' as const;
const strings = t(LOCALE);
const posts = await getPosts(LOCALE);
const categoryKeys = new Set<CategoryKey>();
for (const post of posts) {
  categoryKeys.add(categoryKeyFromName(post.data.kategori ?? DEFAULT_CATEGORY_EN, LOCALE));
}
const categories = CATEGORY_ORDER.filter((k) => categoryKeys.has(k));
---
<Layout locale={LOCALE} title={strings.categoriesPageTitle} description={strings.categoriesPageDesc}>
  <main>
    <h1>{strings.categories}</h1>
    <p class="lede">{strings.allCategories}</p>
    {categories.length === 0 ? (
      <p class="empty">No categories yet.</p>
    ) : (
      <ul>
        {categories.map((key) => {
          const name = categoryLabel(key, LOCALE);
          return (
            <li>
              <a href={categoryPath(LOCALE, CATEGORY_SLUG[LOCALE][key])} style={`--color: ${categoryBadgeColor(name, LOCALE)}`}>
                {name}
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </main>
</Layout>

<style>
  h1 { margin-bottom: 0.25rem; }
  .lede { color: var(--muted); margin: 0 0 2rem; }
  .empty { color: var(--muted); }
  ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.75rem;
  }
  li a {
    display: block;
    padding: 1rem;
    background: var(--surface);
    border-left: 4px solid var(--color);
    border-radius: 8px;
    color: inherit;
    text-decoration: none;
  }
</style>
