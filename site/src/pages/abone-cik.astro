---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Abonelikten Çık — Bilişim Postası" description="Abonelikten çıkış sayfası.">
  <main>
    <h1>Abonelikten Çık</h1>
    <p class="muted" id="status">İşleniyor…</p>
  </main>
  <script is:inline>
    const statusEl = document.getElementById('status');
    const token = new URLSearchParams(window.location.search).get('token');

    if (!token) {
      statusEl.textContent = 'Link geçersiz: token bulunamadı.';
    } else {
      const url = `https://n8n.omerfarukturegun.com.tr/webhook/email-unsubscribe`;
      fetch(`${url}?token=${encodeURIComponent(token)}`)
        .then((r) => r.json())
        .then((data) => {
          if (data && data.ok) {
            statusEl.textContent = 'Aboneliğinizden başarıyla çıkıldı.';
          } else {
            statusEl.textContent = 'Çıkış başarısız. Link geçersiz olabilir.';
          }
        })
        .catch(() => {
          statusEl.textContent = 'Bağlantı hatası oluştu. Lütfen tekrar deneyin.';
        });
    }
  </script>
</Layout>

<style>
  main h1 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    line-height: 1.25;
    margin: 0 0 1rem;
  }
  .muted { color: var(--muted); font-weight: 600; }
</style>

