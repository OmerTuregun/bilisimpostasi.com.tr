---
import { t } from '../i18n/ui';
import Layout from '../layouts/Layout.astro';

const LOCALE = 'tr' as const;
---
<Layout locale={LOCALE} title={`${t(LOCALE).about} — Blog`} description="Teknoloji ve yapay zeka haber platformu hakkında.">
  <main class="paper-page">
    <div class="paper-page-inner">
      <div class="static-page paper-sheet">
        <h1>Bilişim Postası Hakkında</h1>
        <p>Bilişim Postası, teknoloji ve yapay zeka dünyasındaki gelişmeleri Türkçe olarak takip edebileceğiniz bir haber platformudur.</p>
        <p><strong>Kaynaklarımız:</strong> TechCrunch, Ars Technica, Hacker News, arXiv, The Verge, Engadget. Her yazının orijinal kaynağına link veririz.</p>
        <p><strong>İşleten:</strong> Ömer Faruk Türegün</p>
        <p>
          <strong>İletişim:</strong>{' '}
          <a href="mailto:destek@bilisimpostasi.com.tr">destek@bilisimpostasi.com.tr</a>
          {' · '}
          <a href="/iletisim/">İletişim sayfası</a>
        </p>
      </div>
    </div>
  </main>
</Layout>

<style>
  p { line-height: 1.65; margin: 0 0 1rem; }
  p:last-child { margin-bottom: 0; }
</style>
