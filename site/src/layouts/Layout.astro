---
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import { getPosts, homePath, localePrefix, postPath, postSlug, alternatePostPath, switchLocalePath } from '../lib/posts';
import { navCategoriesFromPosts } from '../lib/categories';
import BreakingTicker from '../components/BreakingTicker.astro';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  ogType?: 'website' | 'article';
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Post slug for language switch + hreflang on article pages */
  articleSlug?: string;
  hreflangTr?: string | null;
  hreflangEn?: string | null;
  /** Preload above-the-fold cover URLs (homepage card grid) */
  preloadImages?: string[];
}

const {
  title,
  description,
  locale: localeProp,
  ogType = 'website',
  image,
  jsonLd,
  articleSlug,
  hreflangTr,
  hreflangEn,
  preloadImages = [],
} = Astro.props;
const preloadCoverUrls = [...new Set(preloadImages.filter(Boolean))].slice(0, 6);

const path = Astro.url.pathname;
const locale: Locale = localeProp ?? (path.startsWith('/en') ? 'en' : 'tr');
const strings = t(locale);
const prefix = localePrefix(locale);
const siteBase = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, siteBase);
const defaultOgImage = new URL('/og-default.png', siteBase).href;
const ogImage = image
  ? (image.startsWith('http://') || image.startsWith('https://')
      ? image
      : new URL(image, siteBase).href)
  : defaultOgImage;

const posts = await getPosts(locale);
const navCategories = navCategoriesFromPosts(posts, locale);
const jsonLdString = jsonLd ? JSON.stringify(jsonLd) : null;
const BREAKING_WINDOW_HOURS = 3;
const cutoff = Date.now() - BREAKING_WINDOW_HOURS * 60 * 60 * 1000;
const breakingPosts = posts
  .filter((p) => p.data.pubDate.valueOf() >= cutoff)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const otherLocale: Locale = locale === 'tr' ? 'en' : 'tr';
let langSwitchUrl = homePath(otherLocale);
if (articleSlug) {
  const alt = await alternatePostPath(articleSlug, locale, otherLocale);
  langSwitchUrl = alt ?? homePath(otherLocale);
} else {
  langSwitchUrl = switchLocalePath(path, otherLocale);
}

const isHome = locale === 'tr'
  ? path === '/' || /^\/\d+\/?$/.test(path)
  : path === '/en/' || path === '/en' || /^\/en\/\d+\/?$/.test(path);
const isCategory = path.includes('/kategori/');
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://pub-880c98af22074b02b5f5237e1b3a0bad.r2.dev" crossorigin />
    <link rel="dns-prefetch" href="https://pub-880c98af22074b02b5f5237e1b3a0bad.r2.dev" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap"
      rel="stylesheet"
    />
    {preloadCoverUrls.map((href) => (
      <link rel="preload" as="image" href={href} />
    ))}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {hreflangTr && hreflangEn && (
      <>
        <link rel="alternate" hreflang="tr" href={hreflangTr} />
        <link rel="alternate" hreflang="en" href={hreflangEn} />
        <link rel="alternate" hreflang="x-default" href={hreflangTr} />
      </>
    )}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Blog — RSS"
      href={new URL('/rss.xml', siteBase).href}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLdString && (
      <script type="application/ld+json" set:html={jsonLdString} />
    )}
    <script
      defer
      src="https://analytics.omerfarukturegun.com.tr/script.js"
      data-website-id="66c56023-cd3f-4404-9446-7ead80b286a3"
    ></script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <div class="header-brand-row">
          <a class="brand" href={homePath(locale)}>
            <img src="/navbar-logo.png" alt={strings.siteName} />
          </a>
          <a
            class:list={['lang-toggle', { 'is-en': locale === 'en' }]}
            href={langSwitchUrl}
            hreflang={otherLocale}
            lang={otherLocale}
            aria-label={strings.langSwitchTo}
            title={strings.langSwitchTo}
          >
            <span class="lang-toggle-track" aria-hidden="true">
              <span class="lang-toggle-thumb"></span>
              <span class="lang-side lang-tr">
                {/* SVG flags: Windows renders 🇹🇷/🇬🇧 as "TR"/"GB" letters, not flag images */}
                <span class="lang-flag" title="TR">
                  <svg viewBox="0 0 36 24" width="16" height="11" focusable="false" aria-hidden="true">
                    <rect width="36" height="24" fill="#E30A17"/>
                    <circle cx="12.5" cy="12" r="7" fill="#fff"/>
                    <circle cx="14.2" cy="12" r="5.5" fill="#E30A17"/>
                    <polygon fill="#fff" points="20.2,12 23.8,13.3 22.1,10.1 23.8,6.9 20.2,8.2 17.5,6.2 18.1,10.1 15.5,12 18.1,13.9 17.5,17.8"/>
                  </svg>
                </span>
                <span class="lang-code">TR</span>
              </span>
              <span class="lang-side lang-en">
                <span class="lang-flag" title="EN">
                  <svg viewBox="0 0 60 30" width="16" height="11" focusable="false" aria-hidden="true">
                    <rect width="60" height="30" fill="#012169"/>
                    <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/>
                    <path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="4"/>
                    <path d="M30,0 V30 M0,15 H60" stroke="#fff" stroke-width="10"/>
                    <path d="M30,0 V30 M0,15 H60" stroke="#C8102E" stroke-width="6"/>
                  </svg>
                </span>
                <span class="lang-code">EN</span>
              </span>
            </span>
          </a>
        </div>
        <button
          class="nav-hamburger"
          type="button"
          aria-label={strings.openMenu}
          aria-controls="nav-mobile-drawer"
          aria-expanded="false"
        >
          ☰
        </button>
        <nav class="nav" aria-label={strings.mainNav}>
          <a href={homePath(locale)} class:list={[{ active: isHome }]}>{strings.home}</a>
          <div class="nav-dropdown" class:list={[{ active: isCategory }]}>
            <button class="nav-dropdown-trigger" type="button" aria-expanded="false" aria-haspopup="true">
              {strings.categories} <span aria-hidden="true">▾</span>
            </button>
            <ul class="nav-dropdown-menu">
              {navCategories.map(({ name, slug }) => (
                <li><a href={`${prefix}/kategori/${slug}/`}>{name}</a></li>
              ))}
            </ul>
          </div>
          <a href={`${homePath(locale)}#search`}>{strings.search}</a>
          <a href={`${prefix}/hakkimizda/`} class:list={[{ active: path.endsWith('/hakkimizda/') }]}>{strings.about}</a>
          <a href={`${prefix}/iletisim/`} class:list={[{ active: path.endsWith('/iletisim/') }]}>{strings.contact}</a>
          <button class="nav-subscribe-btn" type="button" id="open-subscribe-modal">{strings.subscribe}</button>
        </nav>

        <div
          id="nav-mobile-drawer"
          class="nav-mobile-drawer"
          aria-hidden="true"
          hidden
        >
          <a href={homePath(locale)} class:list={[{ active: isHome }]} data-close-drawer>{strings.home}</a>
          <a
            href={`${prefix}/kategoriler/`}
            class:list={[{ active: isCategory || path.endsWith('/kategoriler/') }]}
            data-close-drawer
          >{strings.categories}</a>
          <a href={`${homePath(locale)}#search`} data-close-drawer>{strings.search}</a>
          <a href={`${prefix}/hakkimizda/`} class:list={[{ active: path.endsWith('/hakkimizda/') }]} data-close-drawer>{strings.about}</a>
          <a href={`${prefix}/iletisim/`} class:list={[{ active: path.endsWith('/iletisim/') }]} data-close-drawer>{strings.contact}</a>
          <button class="nav-subscribe-btn" type="button" id="open-subscribe-modal-mobile" data-close-drawer>{strings.subscribe}</button>
        </div>
      </div>
      {breakingPosts.length > 0 && (
        <>
          <div class="breaking-divider" aria-hidden="true"></div>
          <BreakingTicker posts={breakingPosts} locale={locale} />
        </>
      )}
    </header>
    <slot />
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {strings.footerTagline}</p>
      <nav class="footer-links" aria-label={strings.legalNav}>
        <a href={`${prefix}/gizlilik-politikasi/`}>{strings.privacy}</a>
        <a href={`${prefix}/kullanim-sartlari/`}>{strings.terms}</a>
      </nav>
    </footer>
    <div id="subscribe-modal" class="subscribe-modal" aria-hidden="true" hidden
      data-msg-sending={strings.subscribeSending}
      data-msg-success={strings.subscribeSuccess}
      data-msg-error={strings.subscribeError}
      data-msg-conn-error={strings.subscribeConnError}
      data-btn-label={strings.subscribeEmailBtn}
    >
      <div class="subscribe-modal-overlay"></div>
      <div class="subscribe-modal-content" role="dialog" aria-modal="true" aria-labelledby="subscribe-modal-title">
        <button class="subscribe-modal-close" type="button" aria-label="×">&times;</button>
        <h2 id="subscribe-modal-title">{strings.subscribeTitle}</h2>
        <p class="subscribe-modal-desc">{strings.subscribeDesc}</p>
        <div class="subscribe-modal-options">
          <div class="subscribe-option">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.2-.08-.06-.19-.04-.28-.02-.12.03-2.02 1.28-5.69 3.77-.54.37-1.03.55-1.47.54-.48-.01-1.41-.27-2.1-.5-.85-.28-1.52-.43-1.46-.9.03-.25.38-.5 1.04-.76 4.09-1.78 6.81-2.96 8.17-3.53 3.89-1.62 4.7-1.9 5.23-1.91.12 0 .37.03.54.17.14.12.18.28.2.45-.01.06.01.24 0 .37z" fill="#2AABEE"/></svg>
            <h3>{strings.subscribeTelegram}</h3>
            <p>{strings.subscribeTelegramDesc}</p>
            <a href="https://t.me/omer_content_bot" target="_blank" rel="noopener" class="subscribe-btn subscribe-btn-telegram">{strings.subscribeTelegramBtn}</a>
          </div>
          <div class="subscribe-option">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" fill="#0b5fff"/></svg>
            <h3>{strings.subscribeEmail}</h3>
            <p>{strings.subscribeEmailDesc}</p>
            <form id="subscribe-email-form" class="subscribe-email-form">
              <input type="email" name="email" placeholder="email@example.com" required autocomplete="email" />
              <label class="subscribe-consent">
                <input type="checkbox" name="consent" required />
                <span>{strings.subscribeConsent}</span>
              </label>
              <button type="submit" class="subscribe-btn subscribe-btn-email">{strings.subscribeEmailBtn}</button>
            </form>
            <div id="subscribe-email-result" class="subscribe-email-result" hidden></div>
          </div>
        </div>
      </div>
    </div>

    <script>
      const dropdown = document.querySelector('.nav-dropdown');
      const dropdownTrigger = dropdown?.querySelector('.nav-dropdown-trigger');
      dropdownTrigger?.addEventListener('click', (event) => {
        event.stopPropagation();
        const open = dropdown?.classList.toggle('open');
        dropdownTrigger.setAttribute('aria-expanded', String(Boolean(open)));
      });
      dropdown?.addEventListener('mouseleave', () => {
        dropdown.classList.remove('open');
        dropdownTrigger?.setAttribute('aria-expanded', 'false');
      });
      document.addEventListener('click', () => {
        dropdown?.classList.remove('open');
        dropdownTrigger?.setAttribute('aria-expanded', 'false');
      });

      // Mobile drawer
      const hamburger = document.querySelector('.nav-hamburger');
      const drawer = document.getElementById('nav-mobile-drawer');

      function setDrawerOpen(open) {
        if (!drawer || !hamburger) return;
        drawer.classList.toggle('open', open);
        drawer.setAttribute('aria-hidden', String(!open));
        drawer.hidden = !open;
        hamburger.setAttribute('aria-expanded', String(open));
      }

      hamburger?.addEventListener('click', () => {
        const isOpen = drawer?.classList.contains('open');
        setDrawerOpen(!isOpen);
      });

      drawer?.addEventListener('click', (event) => {
        const t = event.target;
        if (t?.matches?.('[data-close-drawer]')) setDrawerOpen(false);
      });

      document.addEventListener('click', (event) => {
        const target = event.target;
        const clickedInside = drawer?.contains?.(target) || hamburger?.contains?.(target);
        if (!clickedInside) setDrawerOpen(false);
      });

      // Screenshot/debug helper: add ?menu=1 to force-open on mobile
      if (new URLSearchParams(window.location.search).get('menu') === '1') setDrawerOpen(true);

      // Subscribe modal
      const modal = document.getElementById('subscribe-modal');
      const modalOverlay = modal?.querySelector('.subscribe-modal-overlay');
      const modalClose = modal?.querySelector('.subscribe-modal-close');
      const openBtns = document.querySelectorAll('#open-subscribe-modal, #open-subscribe-modal-mobile');

      function setModalOpen(open) {
        if (!modal) return;
        modal.hidden = !open;
        modal.setAttribute('aria-hidden', String(!open));
        if (open) document.body.style.overflow = 'hidden';
        else document.body.style.overflow = '';
      }

      openBtns.forEach(btn => btn.addEventListener('click', () => setModalOpen(true)));
      modalClose?.addEventListener('click', () => setModalOpen(false));
      modalOverlay?.addEventListener('click', () => setModalOpen(false));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setModalOpen(false); });

      // Email form submit
      const emailForm = document.getElementById('subscribe-email-form');
      const emailResult = document.getElementById('subscribe-email-result');
      const modalEl = document.getElementById('subscribe-modal');
      const msgSending = modalEl?.dataset.msgSending ?? 'Sending...';
      const msgSuccess = modalEl?.dataset.msgSuccess ?? 'Success';
      const msgError = modalEl?.dataset.msgError ?? 'Error';
      const msgConnError = modalEl?.dataset.msgConnError ?? 'Connection error';
      const btnLabel = modalEl?.dataset.btnLabel ?? 'Subscribe';
      emailForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target;
        const email = form.email.value.trim();
        const consent = form.consent.checked;
        if (!email || !consent) return;
        const btn = form.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.textContent = msgSending;
        try {
          const res = await fetch('https://n8n.omerfarukturegun.com.tr/webhook/email-subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, consent: true }),
          });
          if (res.ok) {
            form.hidden = true;
            emailResult.hidden = false;
            emailResult.textContent = msgSuccess;
            emailResult.classList.add('success');
          } else {
            emailResult.hidden = false;
            emailResult.textContent = msgError;
            emailResult.classList.add('error');
          }
        } catch {
          emailResult.hidden = false;
          emailResult.textContent = msgConnError;
          emailResult.classList.add('error');
        }
        btn.disabled = false;
        btn.textContent = btnLabel;
      });
    </script>
    <script>
      // Transient CDN/R2 failures: retry cover images once or twice (no artificial page delay).
      document.addEventListener(
        'error',
        (event) => {
          const target = event.target;
          if (!(target instanceof HTMLImageElement)) return;
          if (!target.classList.contains('card-cover') && !target.classList.contains('cover-img')) return;
          const attempt = Number(target.dataset.retry || '0');
          if (attempt >= 2) return;
          target.dataset.retry = String(attempt + 1);
          try {
            const url = new URL(target.currentSrc || target.src, window.location.href);
            url.searchParams.set('_retry', String(attempt + 1));
            const delay = attempt === 0 ? 0 : 350;
            window.setTimeout(() => {
              target.src = url.toString();
            }, delay);
          } catch {
            /* ignore invalid urls */
          }
        },
        true,
      );
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f6f4ef;
    --ink: #1a1a1a;
    --muted: #5c5c5c;
    --accent: #0b5fff;
    --rule: #d9d4c8;
    --breaking: #c0392b;
    --container: min(72rem, 100% - 2.5rem);
    --font-heading: 'Playfair Display', Georgia, serif;
    --font-body: 'Inter', system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  h1, h2, h3, .name { font-family: var(--font-heading); }
  body {
    margin: 0;
    font-family: var(--font-body);
    background: var(--bg);
    color: var(--ink);
    line-height: 1.55;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  a { color: var(--accent); }
  .site-header {
    background: #fff;
    border-bottom: 1px solid var(--rule);
    position: sticky;
    top: 0;
    z-index: 300;
    overflow: visible;
  }
  .header-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0.6rem 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
  }
  .header-brand-row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
  }
  .brand img {
    display: block;
    height: 58px;
    width: auto;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem;
    margin-left: auto;
  }
  .nav > a, .nav-dropdown-trigger {
    text-decoration: none;
    color: var(--muted);
    font: inherit;
    font-size: 0.92rem;
    padding: 0.45rem 0.75rem;
    border: 0;
    border-radius: 0.35rem;
    background: none;
    cursor: pointer;
  }
  .nav > a:hover, .nav > a.active,
  .nav-dropdown:hover .nav-dropdown-trigger,
  .nav-dropdown.open .nav-dropdown-trigger,
  .nav-dropdown.active .nav-dropdown-trigger {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .nav-dropdown { position: relative; z-index: 310; }
  .nav-dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 400;
    min-width: 11rem;
    margin: 0;
    padding: 0.35rem 0;
    list-style: none;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 0.5rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }
  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown.open .nav-dropdown-menu { display: block; }
  .nav-dropdown-menu a {
    display: block;
    padding: 0.5rem 0.85rem;
    text-decoration: none;
    color: var(--ink);
    font-size: 0.88rem;
  }
  .nav-dropdown-menu a:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  main {
    max-width: var(--container);
    margin: 0 auto;
    padding: 1.75rem 1.25rem 3rem;
    flex: 1;
    width: 100%;
  }
  @media (max-width: 1099px), (hover: none) and (pointer: coarse) {
    main { padding-left: 1rem; padding-right: 1rem; }
  }
  .site-footer {
    border-top: 1px solid var(--rule);
    background: #fff;
    padding: 1.25rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .site-footer p { margin: 0; }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.25rem;
    margin-top: 0.65rem;
  }
  .footer-links a {
    color: var(--muted);
    text-decoration: none;
  }
  .footer-links a:hover { color: var(--ink); text-decoration: underline; }
  @media (max-width: 1099px), (hover: none) and (pointer: coarse) {
    .header-inner {
      padding: 0.65rem 0.9rem;
      flex-wrap: nowrap;
      gap: 0.4rem;
    }
    .brand img { height: 54px; }
    .nav {
      width: auto;
      margin-left: auto;
      justify-content: flex-end;
      flex-wrap: nowrap;
      gap: 0.05rem;
    }
    .nav > a, .nav-dropdown-trigger {
      font-size: 0.78rem;
      padding: 0.32rem 0.42rem;
      white-space: nowrap;
    }
  }

  /* Mobile: show hamburger drawer instead of squeezed inline links */
  @media (max-width: 768px) {
    .brand img { height: 52px; }
    .nav { display: none !important; }
    .header-inner { position: relative; padding-right: 3.4rem; }
    .header-brand-row {
      gap: 0.4rem;
      max-width: calc(100% - 0.25rem);
    }
    .lang-toggle-track {
      width: 4.55rem;
      height: 1.65rem;
    }
    .lang-flag svg {
      width: 14px;
      height: 10px;
    }
    .lang-code { font-size: 0.62rem; }
    .nav-hamburger {
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
      font: inherit;
      font-size: 1.35rem;
      padding: 0;
      width: 44px;
      height: 44px;
